FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -o /bin/runner \
    ./cmd/runner


FROM alpine:3.22

WORKDIR /app

RUN adduser -D appuser

COPY --from=builder /bin/runner /app/runner

USER appuser

CMD ["/app/runner"]